{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-grid",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "grid.tomer.dev", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/data/*", "/he", "/he/*", "/snapshot/*"] },
  // Where the puzzle datasets are downloaded from: the data/ folder of the GitHub repo.
  "vars": { "DATA_ORIGIN": "https://raw.githubusercontent.com/torosent/daily-grid/main/data/" }
}
